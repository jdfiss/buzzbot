# BotFather 給的 Bot Token
BOT_TOKEN=

# my.telegram.org 申請的 api_id / api_hash（Local Bot API Server 啟動要用，
# 變數名稱是 telegram-bot-api.exe 原生支援的環境變數，不用改名）
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local Telegram Bot API Server 的位址（不是 api.telegram.org）
# 例如自架在本機、預設 port 8081：
TELEGRAM_API_BASE=http://localhost:8081

# 課程清單設定檔
COURSES_YAML=courses.yaml

# true：收到錄音問課程、依課程分資料夾（courses/<course>/<date>/）
# false：不問課程，全部進 inbox/<date>/（分課程程式碼還在，隨時可切回 true）
COURSE_SELECTION_ENABLED=true

# 收檔暫存區 / 課程歸檔區 / 不分課程時的收件夾
PENDING_DIR=pending
COURSES_DIR=courses
INBOX_DIR=inbox

# Buzz（本機安裝路徑、模型大小、語言）
BUZZ_EXE=D:\Buzz\Buzz.exe
BUZZ_MODEL_SIZE=medium
BUZZ_LANGUAGE=zh
BUZZ_TIMEOUT_SECONDS=7200
